<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\DustyEngine\DustyEngine.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.10" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.10" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10" />
    </ItemGroup>

    <Target Name="CopyPlayerRunnerDir" AfterTargets="Build">
        <PropertyGroup>
            <SrcDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\PlayerRunner\bin\Release\net9.0'))</SrcDir>
            <DstDir>$([System.IO.Path]::Combine('$(TargetDir)', 'PlayerTemplates', 'linux-x64'))</DstDir>
        </PropertyGroup>

        <RemoveDir Directories="$(DstDir)" Condition="Exists('$(DstDir)')" />
        <MakeDir Directories="$(DstDir)" />

        <Exec Command="cp -r &quot;$(SrcDir)/.&quot; &quot;$(DstDir)/&quot;" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
        <Exec Command="xcopy &quot;$(SrcDir)&quot; &quot;$(DstDir)\&quot; /E /I /Y /Q" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    </Target>

</Project>
